# Starknet JSON-RPC endpoint used for reads (public balances, receipts, events).
# Cartridge serves spec 0.10.2 consistently. Avoid rpc.starknet.lava.build: it is a
# load-balanced mixed pool that intermittently answers with spec 0.8.1 and breaks
# 0.10-style calls.
NEXT_PUBLIC_STARKNET_RPC_URL=https://api.cartridge.gg/x/starknet/mainnet

# STRK20 privacy pool (mainnet).
NEXT_PUBLIC_STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Cordon PolicyGate anonymizer. Leave empty until the contract is deployed; the
# debug page then renders the gate round-trip as unavailable instead of guessing.
NEXT_PUBLIC_CORDON_GATE_ADDRESS=

# The published policy the Pay screen settles under in live mode. Unset means the
# screen reports the missing precondition rather than settling under a guess.
NEXT_PUBLIC_CORDON_POLICY_ID=

# The pool user a live demo payment credits.
NEXT_PUBLIC_CORDON_PAYEE=
